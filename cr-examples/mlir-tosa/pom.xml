<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>bruno-ah-um.code</groupId>
    <artifactId>mlir-tosa</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- Requires JDK 26+ build (Babylon) to work with code reflection -->
    <properties>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.0</junit.version>
        <!--
          Set to true to skip regenerating bindings with jextract (requires jextract on PATH).
          Defaults to true: bindings are committed and should only be regenerated explicitly
          when the C API changes (mvn generate-sources -Dskip.jextract=false).
        -->
        <skip.jextract>true</skip.jextract>
        <!--
          Set to true to skip native (CMake/LLVM) compilation.
          Use the 'no-native' profile for a full no-LLVM build:
            mvn package -Pno-native
        -->
        <skip.cmake>false</skip.cmake>
    </properties>

    <dependencies>
        <!-- JUnit 5 for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JMH for benchmarking -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>4.0.0-M9</version>
                </plugin>
                <plugin>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>3.4.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>26</release>
                        <target>26</target>
                        <compilerArgs>
                            <arg>--enable-preview</arg>
                            <arg>--add-modules=jdk.incubator.code</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                    <configuration>
                        <argLine>--enable-preview --add-modules=jdk.incubator.code</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Maven Compiler Plugin (must be explicitly configured outside of pluginManagement) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>26</release>
                    <target>26</target>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                        <arg>--add-modules=jdk.incubator.code</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- Maven Surefire Plugin for tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <argLine>--enable-preview --add-modules=jdk.incubator.code --enable-native-access=ALL-UNNAMED -Djava.library.path=${project.basedir}/lib/build</argLine>
                    <environmentVariables>
                        <LD_LIBRARY_PATH>${project.basedir}/lib/build:${env.LD_LIBRARY_PATH}</LD_LIBRARY_PATH>
                    </environmentVariables>
                </configuration>
            </plugin>
            <!-- Exec Maven Plugin for CMake build -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <!-- Run configure.sh script (skipped when skip.cmake=true) -->
                    <execution>
                        <id>cmake-configure</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.cmake}</skip>
                            <executable>bash</executable>
                            <workingDirectory>${project.basedir}/lib</workingDirectory>
                            <arguments>
                                <argument>configure.sh</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- CMake build step (skipped when skip.cmake=true) -->
                    <execution>
                        <id>cmake-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.cmake}</skip>
                            <executable>cmake</executable>
                            <workingDirectory>${project.basedir}/lib</workingDirectory>
                            <arguments>
                                <argument>--build</argument>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- JExtract to generate Java bindings from C header -->
                    <!-- OPTIONAL: Only runs if jextract is installed and skip.jextract is not set -->
                    <execution>
                        <id>jextract-generate-bindings</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.jextract}</skip>
                            <executable>jextract</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <!-- Output directory for generated bindings -->
                                <argument>--output</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <!-- Target package name -->
                                <argument>--target-package</argument>
                                <argument>mlir.tosa.bindings</argument>
                                <!-- Library path for runtime loading -->
                                <argument>--library</argument>
                                <argument>mlir_tosa_c</argument>
                                <!-- Include path for headers -->
                                <argument>-I</argument>
                                <argument>${project.basedir}/lib</argument>
                                <!-- Header file to process -->
                                <argument>${project.basedir}/lib/mlir_tosa_c_api.h</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Checkstyle style/convention analysis -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <configLocation>${project.basedir}/checkstyle.xml</configLocation>
                    <failsOnError>true</failsOnError>
                    <consoleOutput>true</consoleOutput>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Copy resolved native library into JAR resources under /native/ -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>bundle-native-lib</id>
                        <phase>process-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <skip>${skip.cmake}</skip>
                            <target>
                                <mkdir dir="${project.build.outputDirectory}/native"/>
                                <exec executable="cp">
                                    <arg value="-L"/>
                                    <arg value="${project.basedir}/lib/build/libmlir_tosa_c.so"/>
                                    <arg value="${project.build.outputDirectory}/native/libmlir_tosa_c.so"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Clean Plugin to remove CMake build directory.
                 Note: bindings are no longer deleted on clean (skip.jextract=true by default). -->
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.basedir}/lib/build</directory>
                            <followSymlinks>false</followSymlinks>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      Use -Pno-native to build and test without an LLVM/MLIR installation.
      This skips CMake compilation and excludes tests that require the
      native libmlir_tosa_c library at runtime.

        mvn package -Pno-native

      The pre-generated JExtract bindings in src/main/java/mlir/tosa/bindings/
      must still be present (do not run 'mvn clean' without LLVM available).
    -->
    <profiles>
        <!--
          Use -Pwith-examples to bundle the example/benchmark classes (from src/test/java)
          into the main JAR, making them callable from the demo notebook.

            mvn package -Pwith-examples -DskipTests
        -->
        <profile>
            <id>with-examples</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <!-- Copy test classes into the main output directory in the
                         process-test-classes phase: after test-compile but before the test
                         phase. Tests still run from target/test-classes (surefire's classpath),
                         so the copy does not affect test execution or incremental builds. -->
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>copy-example-classes</id>
                                <phase>process-test-classes</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <copy todir="${project.build.outputDirectory}">
                                            <fileset dir="${project.build.testOutputDirectory}"
                                                     includes="**/*.class"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>no-native</id>
            <properties>
                <skip.cmake>true</skip.cmake>
                <skip.jextract>true</skip.jextract>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.1.2</version>
                        <configuration>
                            <!-- No native library path needed -->
                            <argLine>--enable-preview --add-modules=jdk.incubator.code --enable-native-access=ALL-UNNAMED</argLine>
                            <!-- Exclude tests that load the native MLIR library at runtime -->
                            <excludes>
                                <exclude>**/TosaCompilerTest.java</exclude>
                                <exclude>**/NativeMNISTTest.java</exclude>
                                <exclude>**/TosaModelExporterTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
